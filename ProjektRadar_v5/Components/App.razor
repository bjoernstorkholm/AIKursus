<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <button id="toTop" class="to-top" aria-label="Til toppen" title="Til toppen" type="button" onclick="window.projectRadar.scrollToTop()">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 8.5l-5 5h10l-5-5z" fill="currentColor" />
        </svg>
    </button>
    <script src="js/projektradar.js"></script>
    <script>
        (function(){
            function init(){
                try{ if (window.projectRadar && typeof window.projectRadar.initToTop === 'function') window.projectRadar.initToTop(); } catch(e){}
            }
            if (document.readyState === 'complete' || document.readyState === 'interactive') init();
            else document.addEventListener('DOMContentLoaded', init);
        })();
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
